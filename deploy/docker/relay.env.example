TQSDK_RELAY_DOWNSTREAM_LISTEN=127.0.0.1:7788
TQSDK_RELAY_METRICS_LISTEN=127.0.0.1:7789
TQSDK_RELAY_HISTORY_LISTEN=127.0.0.1:7790
TQSDK_RELAY_HISTORY_IDENTITY_HEADER=X-Trusted-Identity

# Compose supplies TQSDK_RELAY_HISTORY_ROOT at the fixed read-only container path.
# Leaving TQSDK_RELAY_FUTURES_UNIVERSE unset starts history/metrics without an
# upstream market connection. A static market example is:
# TQSDK_RELAY_FUTURES_UNIVERSE=symbol:SHFE.au2602,DCE.m2609
# TQSDK_RELAY_UPSTREAM_TICK_VIEW_WIDTH=1
# TQSDK_RELAY_TICK_RING_CAPACITY=10000

# Dynamic universe selectors require TQ_AUTH_USER/TQ_AUTH_PASS. Put secrets in
# a protected production env file or secret manager, never in this template.

# CPU affinity is deliberately disabled by default. If enabled later, both
# variables must be present, disjoint, and inside the container cpuset.
# TQSDK_RELAY_MARKET_CPU_SET=0
# TQSDK_RELAY_HISTORY_CPU_SET=1-2
