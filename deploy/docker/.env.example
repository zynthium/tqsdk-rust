# Host paths. Both must already exist; Compose will not create them.
TQSDK_WRITABLE_CACHE_ROOT=/var/lib/tqsdk/history-writable
TQSDK_LIVE_CACHE_ROOT=/var/lib/tqsdk/history-writable
TQSDK_HISTORY_ROOT=/var/lib/tqsdk/history-published

# Match the numeric owner allowed to read/write the host paths.
TQSDK_CONTAINER_UID=10001
TQSDK_CONTAINER_GID=10001
TQSDK_TIMEZONE=Asia/Shanghai

# Pin these to an immutable registry tag or digest for production rollouts.
TQSDK_RELAY_IMAGE=tqsdk-relay:local
TQSDK_CACHE_IMAGE=tqsdk-cache:local
